---
import type { Brand } from "../lib/schema.ts";
interface Props { b: Brand }
const { b } = Astro.props;
const n = b.process.length;
---
{n > 0 && (
  <section class:list={["section", !b.offer && "pt-0 sm:pt-0"]}>
    <div class="container-x">
      <p class="sec-label">Process</p>
      <h2 class="h2 mt-5">Sorted in {n} simple steps</h2>
      <ol class:list={["mt-14 grid gap-12 md:gap-10", n === 4 ? "md:grid-cols-4" : n === 3 ? "md:grid-cols-3" : "md:grid-cols-2"]}>
        {b.process.map((s, i) => (
          <li class="rule-t pt-7">
            <div class="reveal">
              <span class="tnum font-heading text-5xl italic leading-none text-accent-deep">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="mt-6 text-2xl">{s.title}</h3>
              <p class="mt-3 max-w-sm text-muted">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}
