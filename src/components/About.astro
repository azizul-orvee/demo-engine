---
import type { Brand } from "../lib/schema.ts";
import { assetUrl } from "../lib/clients.ts";
import Icon from "./Icon.astro";
interface Props { b: Brand }
const { b } = Astro.props;
const a = b.about;
const img = assetUrl(b.slug, a?.image);
const years = b.business.yearEstablished ? new Date().getFullYear() - b.business.yearEstablished : undefined;
const facts = [
  b.business.gasSafeNumber && `Gas Safe Registered #${b.business.gasSafeNumber}`,
  b.business.oftecNumber && `OFTEC Registered #${b.business.oftecNumber}`,
  ...b.accreditations.filter((x) => !/gas safe|oftec/i.test(x)).slice(0, 3),
].filter(Boolean) as string[];
const [lede, ...rest] = a ? a.text.split(/\n\n+/) : [];
---
{a && (
  <section class="section bg-paper">
    <div class="container-x grid gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-5">
        {img ? (
          <div class="overflow-hidden bg-rule">
            <img src={img} alt={`${b.business.name} at work`} class="curtain aspect-[4/5] w-full object-cover" loading="lazy" />
          </div>
        ) : (
          <>
            <p class="sec-label">About</p>
            <h2 class="h2 mt-5">{a.title}</h2>
            {years && years > 1 && (
              <div class="rule-t mt-12 pt-7">
                <p class="tnum font-heading leading-none text-ink" style="font-size:clamp(5rem,3rem + 6vw,8.5rem)">{years}</p>
                <p class="mt-3 font-heading text-lg italic text-muted">years in business, since {b.business.yearEstablished}</p>
              </div>
            )}
          </>
        )}
      </div>
      <div class="lg:col-span-7 lg:self-center">
        {img && <><p class="sec-label">About</p><h2 class="h2 mt-5">{a.title}</h2></>}
        <div class:list={["reveal", img && "mt-8"]}>
          <p class="font-heading text-2xl leading-snug text-ink sm:text-[1.75rem]">{lede}</p>
          {rest.map((p) => <p class="mt-5 text-lg text-muted">{p}</p>)}
        </div>
        {img && years && years > 1 && (
          <p class="rule-t mt-10 flex items-baseline gap-4 pt-7"><span class="tnum font-heading text-6xl leading-none">{years}</span><span class="font-heading text-lg italic text-muted">years in business, since {b.business.yearEstablished}</span></p>
        )}
        {facts.length > 0 && (
          <ul class="rule-t mt-10 grid gap-x-10 sm:grid-cols-2">
            {facts.map((f) => <li class="rule-b flex items-center gap-3 py-3.5 text-[15px] font-medium"><Icon name="shield" class="size-4 shrink-0 text-accent-deep" />{f}</li>)}
          </ul>
        )}
      </div>
    </div>
  </section>
)}
